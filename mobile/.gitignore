# Local SDK path, machine-specific -- never committed.
local.properties

# Gradle / Android build output.
.gradle/
build/
*/build/
.cxx/
.idea/
captures/
*.iml

# Stray SQLite files from local runs.
*.db

# The SQLDelight schema snapshot is the baseline `verifyMigrations` replays
# a numbered .sqm against, so it is checked in and regenerated with
# ./gradlew :shared:generateCommonMainHeroldDatabaseSchema.
!shared/src/commonMain/sqldelight/databases/*.db
