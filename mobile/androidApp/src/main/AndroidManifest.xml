<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Requested contextually after the first successful sync, not at
         launch (REQ-AND-PUSH-03). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Unlock before the token is released to the network layer, when the
         user has turned it on (REQ-AND-AUTH-11). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:name=".HeroldApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Herold">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Where herold's authorization endpoint redirects the system
             browser back to (REQ-AND-AUTH-01/02). The private-use scheme is
             this app's alone (RFC 8252 section 7.1); the activity finishes
             the code exchange and hands control back to the shell. -->
        <activity
            android:name=".auth.OAuthCallbackActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.netzhansa.herold" />
            </intent-filter>
        </activity>

        <!-- Data-only FCM messages wake this service, which reconciles and
             posts the notification (REQ-AND-PUSH-10..13). -->
        <service
            android:name=".push.HeroldMessagingService"
            android:exported="false"
            android:directBootAware="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Archive and Mark Read from the shade, applied without opening
             the app (REQ-AND-PUSH-20). -->
        <receiver
            android:name=".push.NotificationActionReceiver"
            android:exported="false" />

    </application>

</manifest>
