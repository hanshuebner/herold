<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Requested contextually after the first successful sync, not at
         launch (REQ-AND-PUSH-03). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Unlock before the token is released to the network layer, when the
         user has turned it on (REQ-AND-AUTH-11). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Whether Play Services is installed decides the automatic push
         transport (REQ-AND-PUSH-05); the connector declares its own query
         for distributor packages. -->
    <queries>
        <package android:name="com.google.android.gms" />
    </queries>

    <application
        android:name=".HeroldApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Herold">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- The static Compose shortcut of the launcher's long-press
                 menu (REQ-AND-SYS-22). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

            <!-- Share target: text and files open compose with the text
                 in the body and the files attached (REQ-AND-SYS-01). -->
            <intent-filter android:label="@string/share_target_label">
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>

            <!-- The device's mail handler: a mailto: link anywhere on the
                 phone opens this composer (REQ-AND-SYS-03). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mailto" />
            </intent-filter>

            <!-- The internal scheme notifications, shortcuts, the widget
                 and the tile address the shell with (REQ-AND-SYS-10). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="herold" />
            </intent-filter>

            <!-- App Links for the deployment origin (REQ-AND-SYS-11).
                 The Suite routes on the fragment
                 (https://host/#/mail/thread/<id>), which leaves "/" as the
                 path an intent filter can match; the fragment is read by
                 the shell's own routing. Verification needs the origin to
                 serve /.well-known/assetlinks.json, recorded in
                 docs/design/android/notes/server-contract.md. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="mail.netzhansa.com" android:path="/" />
                <data android:scheme="https" android:host="mail.netzhansa.com" android:path="" />
            </intent-filter>
        </activity>

        <!-- Where herold's authorization endpoint redirects the system
             browser back to (REQ-AND-AUTH-01/02). The private-use scheme is
             this app's alone (RFC 8252 section 7.1); the activity finishes
             the code exchange and hands control back to the shell. -->
        <activity
            android:name=".auth.OAuthCallbackActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.netzhansa.herold" />
            </intent-filter>
        </activity>

        <!-- Data-only FCM messages wake this service, which reconciles and
             posts the notification (REQ-AND-PUSH-10..13). -->
        <service
            android:name=".push.HeroldMessagingService"
            android:exported="false"
            android:directBootAware="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- The UnifiedPush distributor broadcasts the endpoint and every
             push here (REQ-AND-PUSH-04). The sender is another app, so the
             receiver is exported; the connector matches the instance token
             it handed the distributor before anything is acted on. -->
        <receiver
            android:name=".push.HeroldUnifiedPushReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.MESSAGE" />
                <action android:name="org.unifiedpush.android.connector.NEW_ENDPOINT" />
                <action android:name="org.unifiedpush.android.connector.REGISTRATION_FAILED" />
                <action android:name="org.unifiedpush.android.connector.UNREGISTERED" />
            </intent-filter>
        </receiver>

        <!-- Archive and Mark Read from the shade, applied without opening
             the app (REQ-AND-PUSH-20). -->
        <receiver
            android:name=".push.NotificationActionReceiver"
            android:exported="false" />

        <!-- The home-screen widget, rendered from the local store
             (REQ-AND-SYS-20). -->
        <receiver
            android:name=".home.InboxWidgetReceiver"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/inbox_widget_info" />
        </receiver>

        <!-- The Quick Settings tile, carrying the action the user chose
             (REQ-AND-SYS-21). -->
        <service
            android:name=".home.HeroldTileService"
            android:exported="true"
            android:icon="@drawable/ic_notification"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>

</manifest>
