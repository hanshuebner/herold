<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
    usesCleartextTraffic is on for Phase 0 only, so the sign-in screen can
    reach a scripts/dev-instance.sh ephemeral instance (plain http on
    10.0.2.2:<port> from the emulator). A real deployment always talks to a
    TLS herold; this reverts once Phase 0's manual base-URL field is
    replaced by the production discovery flow.
    -->
    <application
        android:label="@string/app_name"
        android:icon="@android:drawable/sym_def_app_icon"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
