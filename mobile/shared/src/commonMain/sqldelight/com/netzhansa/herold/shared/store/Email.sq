-- Email metadata plus the cached rendered body. `mailboxIds` and `keywords`
-- are space-delimited id/keyword sets for direct rendering; email_mailbox
-- carries the same membership relationally so the inbox query can join
-- against mailbox roles.
--
-- A metadata refresh is an insert-if-absent followed by an update of the
-- metadata columns, so a re-sync of an email whose body is already cached
-- keeps the cached body.

CREATE TABLE email (
    accountId TEXT NOT NULL,
    id TEXT NOT NULL,
    threadId TEXT NOT NULL,
    blobId TEXT,
    fromName TEXT NOT NULL DEFAULT '',
    fromEmail TEXT NOT NULL DEFAULT '',
    toLine TEXT NOT NULL DEFAULT '',
    subject TEXT NOT NULL DEFAULT '',
    preview TEXT NOT NULL DEFAULT '',
    receivedAt INTEGER NOT NULL DEFAULT 0,
    size INTEGER NOT NULL DEFAULT 0,
    hasAttachment INTEGER NOT NULL DEFAULT 0,
    snoozedUntil TEXT,
    keywords TEXT NOT NULL DEFAULT '',
    mailboxIds TEXT NOT NULL DEFAULT '',
    bodyHtml TEXT,
    bodyText TEXT,
    bodyFetchedAt INTEGER,
    attachmentsJson TEXT,
    PRIMARY KEY (accountId, id)
);

CREATE INDEX email_thread ON email(accountId, threadId);
CREATE INDEX email_received ON email(receivedAt);

CREATE TABLE email_mailbox (
    accountId TEXT NOT NULL,
    emailId TEXT NOT NULL,
    mailboxId TEXT NOT NULL,
    PRIMARY KEY (accountId, emailId, mailboxId)
);

CREATE INDEX email_mailbox_box ON email_mailbox(accountId, mailboxId);

insertIfAbsent:
INSERT OR IGNORE INTO email(accountId, id, threadId) VALUES (?, ?, ?);

updateMeta:
UPDATE email SET
    threadId = ?,
    blobId = ?,
    fromName = ?,
    fromEmail = ?,
    toLine = ?,
    subject = ?,
    preview = ?,
    receivedAt = ?,
    size = ?,
    hasAttachment = ?,
    snoozedUntil = ?,
    keywords = ?,
    mailboxIds = ?
WHERE accountId = ? AND id = ?;

updateMembership:
UPDATE email SET keywords = ?, mailboxIds = ?, snoozedUntil = ? WHERE accountId = ? AND id = ?;

storeBody:
UPDATE email SET bodyHtml = ?, bodyText = ?, attachmentsJson = ?, bodyFetchedAt = ?
WHERE accountId = ? AND id = ?;

selectById:
SELECT * FROM email WHERE accountId = ? AND id = ?;

selectByThread:
SELECT * FROM email WHERE accountId = ? AND threadId = ? ORDER BY receivedAt;

selectInbox:
SELECT email.* FROM email
JOIN email_mailbox ON email_mailbox.accountId = email.accountId AND email_mailbox.emailId = email.id
JOIN mailbox ON mailbox.accountId = email_mailbox.accountId AND mailbox.id = email_mailbox.mailboxId
WHERE mailbox.role = 'inbox'
ORDER BY email.receivedAt DESC
LIMIT ?;

selectAll:
SELECT * FROM email ORDER BY receivedAt DESC;

deleteById:
DELETE FROM email WHERE accountId = ? AND id = ?;

deleteForAccount:
DELETE FROM email WHERE accountId = ?;

insertMembership:
INSERT OR REPLACE INTO email_mailbox(accountId, emailId, mailboxId) VALUES (?, ?, ?);

deleteMembership:
DELETE FROM email_mailbox WHERE accountId = ? AND emailId = ?;

deleteMembershipForAccount:
DELETE FROM email_mailbox WHERE accountId = ?;
