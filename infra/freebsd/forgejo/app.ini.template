; Forgejo configuration template for the self-hosted herold code host.
;
; infra/freebsd/forgejo/install.sh fills in the __PLACEHOLDER__ tokens
; with freshly-generated secrets on first install, then writes the
; result to /usr/local/etc/forgejo/app.ini. The committed file in the
; repo is the template only -- the rendered app.ini lives on the
; FreeBSD host and is never committed.

APP_NAME = code.netzhansa.com
RUN_USER = git
RUN_MODE = prod
WORK_PATH = /var/db/forgejo

[server]
PROTOCOL = http
DOMAIN = code.netzhansa.com
ROOT_URL = https://code.netzhansa.com/
HTTP_ADDR = 127.0.0.1
HTTP_PORT = 3001
APP_DATA_PATH = /var/db/forgejo/data
DISABLE_SSH = false
START_SSH_SERVER = true
SSH_DOMAIN = code.netzhansa.com
SSH_LISTEN_HOST = 0.0.0.0
SSH_PORT = 2222
SSH_LISTEN_PORT = 2222
OFFLINE_MODE = false
LFS_START_SERVER = false

[database]
DB_TYPE = sqlite3
PATH = /var/db/forgejo/data/forgejo.db
LOG_SQL = false

[indexer]
ISSUE_INDEXER_TYPE = bleve
ISSUE_INDEXER_PATH = /var/db/forgejo/indexers/issues.bleve

[session]
PROVIDER = file
PROVIDER_CONFIG = /var/db/forgejo/data/sessions

[picture]
AVATAR_UPLOAD_PATH = /var/db/forgejo/data/avatars
REPOSITORY_AVATAR_UPLOAD_PATH = /var/db/forgejo/data/repo-avatars
DISABLE_GRAVATAR = false
ENABLE_FEDERATED_AVATAR = false

[attachment]
PATH = /var/db/forgejo/data/attachments

[log]
MODE = console
LEVEL = info
ROOT_PATH = /var/log/forgejo

[security]
INSTALL_LOCK = true
SECRET_KEY = __SECRET_KEY__
INTERNAL_TOKEN = __INTERNAL_TOKEN__
PASSWORD_HASH_ALGO = pbkdf2_hi

[service]
DISABLE_REGISTRATION = true
REQUIRE_SIGNIN_VIEW = false
ENABLE_NOTIFY_MAIL = false
DEFAULT_KEEP_EMAIL_PRIVATE = false
DEFAULT_ALLOW_CREATE_ORGANIZATION = true

[openid]
ENABLE_OPENID_SIGNIN = false
ENABLE_OPENID_SIGNUP = false

[mailer]
ENABLED = false

[actions]
ENABLED = true
; DEFAULT_ACTIONS_URL=github tells Forgejo Actions to resolve
; actions/checkout@v4 etc. against github.com. The alternative
; (DEFAULT_ACTIONS_URL=self) would look them up inside this instance,
; which is pointless for a single-repo deploy.
DEFAULT_ACTIONS_URL = github

[oauth2]
JWT_SECRET = __JWT_SECRET__

[repository]
DEFAULT_BRANCH = main
ENABLE_PUSH_CREATE_USER = false
ENABLE_PUSH_CREATE_ORG = false
; Forgejo's default SCRIPT_TYPE is "bash", which FreeBSD does not
; ship in base. Use /bin/sh instead (works for the git hooks
; Forgejo generates).
SCRIPT_TYPE = sh

[ui]
DEFAULT_THEME = forgejo-auto
